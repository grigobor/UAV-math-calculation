<?xml version="1.0"?>
<fdm_config name="Adaptive_Tailsitter" version="2.0" release="BETA">
    <fileheader>
        <author>Grigorii Borodachev</author>
        <organization>
            Department of Aeronautical Engineering,
            Moscow Aviation Institut,
            Russia
        </organization>
        <version>0.1</version>
        <description>Model a 2026 G1-T UAV</description>
    </fileheader>

    <metrics>
        <wingarea unit="M2"> 0.3629 </wingarea>
        <wingspan unit="M"> 1.7038 </wingspan>
        <chord unit="M"> 0.2183 </chord>
        <vtailarea unit="M2"> 0.0388 </vtailarea>
        <vtailarm unit="M"> 0.2966 </vtailarm>
        <location name="AERORP" unit="M">
            <x> 0.0546 </x> <y> 0.0 </y> <z> 0.0 </z>
        </location>
        <location name="VRP" unit="M">
            <x> 0.0 </x> <y> 0.0 </y> <z> 0.0 </z>
        </location>
    </metrics>

    <mass_balance>
        <ixx unit="KG*M2"> 1.7911 </ixx>
        <iyy unit="KG*M2"> 0.0294 </iyy>
        <izz unit="KG*M2"> 1.8205 </izz>
        <emptywt unit="KG"> 7.4036 </emptywt>
        <location name="CG" unit="M">
            <x> 0.0437 </x> <y> 0.0 </y> <z> 0.0 </z>
        </location>
    </mass_balance>

    <ground_reactions>
        <contact type="STRUCTURE" name="WING_TIPS">
            <location unit="M">
                <x>-0.2</x>
                <y>0.0</y>
                <z>0.0</z>
            </location>
            <static_friction_coefficient>0.8</static_friction_coefficient>
            <dynamic_friction_coefficient>0.6</dynamic_friction_coefficient>
        </contact>
    </ground_reactions>

    <aerodynamics aero_ref_pt_hx="0.0546" aero_ref_pt_hy="0.0" aero_ref_pt_hz="0.0">
        <axis name="LIFT">
            <function name="CL">
                <table>
                    <independentVar lookup="row">aero/alpha-deg</independentVar>
                    <tableData>
       2.4 0.5000
       3.0 0.6000
       3.8 0.7000
       5.7 0.9000
       7.5 1.1000
                    </tableData>
                </table>
            </function>
            <function name="CD">
                <table>
                    <independentVar lookup="row">aero/alpha-deg</independentVar>
                    <tableData>
       2.4 0.0086
       3.0 0.0089
       3.8 0.0091
       5.7 0.0096
       7.5 0.0106
                    </tableData>
                </table>
            </function>
            <function name="Cm">
                <table>
                    <independentVar lookup="row">aero/alpha-deg</independentVar>
                    <tableData>
       2.4 -0.0118
       3.0 -0.0199
       3.8 -0.0200
       5.7 -0.0188
       7.5 -0.0200
                    </tableData>
                </table>
            </function>
        </axis>
    </aerodynamics>
</fdm_config>
